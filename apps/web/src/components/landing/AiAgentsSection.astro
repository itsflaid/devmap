---

const flows = [
  { command: "devmap init", output: "DEVMAP.md" },
  { command: "devmap analyze", output: ".devmap/snapshot.json" },
];

const compatibleTools = [
  "Claude Code",
  "Codex",
  "Gemini CLI",
  "Cursor",
  "Copilot",
];
---

<section id="ai-agents" class="landing-section ai-agents-section">
  <h2 class="ai-agents-section__title">
    Your AI agent is only as good as its <span class="ai-agents-section__accent">context</span>.
  </h2>

  <p class="ai-agents-section__copy">
    Without DevMap, your AI agent explores your codebase blindly, opening
    files one by one, guessing what matters, rebuilding context from scratch
    every session.
  </p>

  <p class="ai-agents-section__copy">
    With DevMap, your agent gets a ready-made project map. Framework, entry
    points, critical files, data flow, all structured, all accurate, all
    generated from static analysis.
  </p>

  <div class="ai-agents-section__flow">
    {flows.map((flow) => (
      <div class="ai-flow-row">
        <code class="ai-flow-row__command">{flow.command}</code>
        <span class="ai-flow-row__arrow" aria-hidden="true">→</span>
        <code class="ai-flow-row__output">{flow.output}</code>
      </div>
    ))}
  </div>

  <p class="ai-agents-section__closing">
    Your AI agent reads the map. Not the entire codebase. Faster execution.
    Lower token usage. Better results.
  </p>

  <p class="ai-agents-section__compatible">
    Compatible with: {compatibleTools.join(", ")}
  </p>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { revealOnScroll } from "../../scripts/scroll-reveal";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion =
    window.matchMedia &&
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const section = document.querySelector<HTMLElement>(".ai-agents-section");

  revealOnScroll(section, ".ai-agents-section__title", { y: 16 });
  revealOnScroll(section, ".ai-agents-section__copy", {
    y: 16,
    stagger: 0.12,
    start: "top 82%",
  });
  revealOnScroll(
    section,
    ".ai-agents-section__closing, .ai-agents-section__compatible",
    { y: 14, stagger: 0.1, start: "top 75%" }
  );

  // The flow box gets its own sequenced animation instead of the shared
  // fade-up reveal: command slides in, the arrow "pings", then the
  // output pops in — reading like the command is actually resolving
  // live rather than the row just fading into place.
  const flowBox = section?.querySelector<HTMLElement>(".ai-agents-section__flow");
  const flowRows = flowBox
    ? Array.from(flowBox.querySelectorAll<HTMLElement>(".ai-flow-row"))
    : [];

  if (flowBox && !prefersReducedMotion) {
    gsap.set(flowBox, { opacity: 0, y: 20 });

    const tl = gsap.timeline({
      scrollTrigger: { trigger: section, start: "top 78%", once: true },
    });

    tl.to(flowBox, { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" });

    flowRows.forEach((row, index) => {
      const command = row.querySelector<HTMLElement>(".ai-flow-row__command");
      const arrow = row.querySelector<HTMLElement>(".ai-flow-row__arrow");
      const output = row.querySelector<HTMLElement>(".ai-flow-row__output");
      const parts = [command, arrow, output].filter(
        (el): el is HTMLElement => Boolean(el)
      );

      if (!parts.length) return;

      gsap.set(parts, { opacity: 0 });
      if (command) gsap.set(command, { x: -8 });
      if (arrow) gsap.set(arrow, { scale: 0.5 });
      if (output) gsap.set(output, { scale: 0.85 });

      const entryPosition = index === 0 ? "-=0.15" : "-=0.1";

      if (command) {
        tl.to(
          command,
          { opacity: 1, x: 0, duration: 0.35, ease: "power2.out" },
          entryPosition
        );
      }
      if (arrow) {
        tl.to(
          arrow,
          { opacity: 1, scale: 1.25, duration: 0.2, ease: "power1.out" },
          "-=0.1"
        ).to(arrow, { scale: 1, duration: 0.15, ease: "power1.inOut" });
      }
      if (output) {
        tl.to(
          output,
          { opacity: 1, scale: 1, duration: 0.3, ease: "back.out(2)" },
          "-=0.05"
        );
      }
    });
  }
</script>

<style>
  .ai-agents-section {
    padding: var(--section-spacing) 0;
    text-align: center;
  }

  .ai-agents-section__title {
    margin: 0 auto 1.25rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 700;
    max-width: 40rem;
  }

  .ai-agents-section__accent {
    color: var(--color-aqua);
  }

  .ai-agents-section__copy {
    max-width: 36rem;
    margin: 0 auto 1rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .ai-agents-section__copy:last-of-type {
    margin-bottom: 2.25rem;
  }

  .ai-agents-section__flow {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    max-width: 100%;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg-soft);
    box-sizing: border-box;
  }

  .ai-flow-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.375rem 0.625rem;
    max-width: 100%;
  }

  .ai-flow-row__command,
  .ai-flow-row__output {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .ai-flow-row__command {
    color: var(--color-text);
  }

  .ai-flow-row__arrow {
    color: var(--color-text-subtle);
  }

  .ai-flow-row__output {
    color: var(--color-text-muted);
  }

  .ai-agents-section__closing {
    margin: 2.25rem auto 0;
    max-width: 36rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  .ai-agents-section__compatible {
    margin: 1.5rem 0 0;
    font-size: 0.875rem;
    color: var(--color-text-subtle);
  }

  @media (max-width: 640px) {
    .ai-agents-section__flow {
      align-items: center;
    }
  }
</style>
