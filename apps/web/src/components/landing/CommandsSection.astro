---
const commands = [
  {
    command: "devmap init",
    query: "how do I get started",
    coreQuestion: "How do I get started?", // CONSTRUCTED
    output: [
      "Provider:   ✓ Groq",
      "API Key:    ✓ Valid",
      "Project:    ✓ Next.js detected",
      "Run: devmap analyze",
    ], // REAL — condensed from docs/commands.md
  },
  {
    command: "devmap analyze",
    query: "what is this codebase",
    coreQuestion: "What is this codebase, structurally?", // CONSTRUCTED
    output: [
      "PROJECT      devnote",
      "FRAMEWORK    Next.js",
      "Entry Points → app/layout.tsx",
      "Critical Files → lib/auth.ts",
    ], // REAL — condensed from docs/commands.md
  },
  {
    command: "devmap onboarding",
    query: "where do I start reading",
    coreQuestion: "Where should I start reading this project?", // REAL — docs/roadmap.md
    output: [
      "Start here:",
      "1. app/layout.tsx — root layout",
      "2. lib/auth.ts — session handling",
      "3. lib/db.ts — data access",
    ], // MOCK — shape matches documented "Start here" ordered path
  },
  {
    command: "devmap map authentication",
    query: "what does auth connect to",
    coreQuestion: "This file/feature — what does it connect to, and how?", // REAL — docs/roadmap.md
    output: [
      "auth.ts",
      "├─ used by → session/route.ts",
      "├─ used by → middleware.ts",
      "└─ uses → db.ts",
    ], // MOCK — shape matches documented dependency tree
  },
  {
    command: "devmap flow authentication",
    query: "how does login work end to end",
    coreQuestion: "How does this feature work from start to finish?", // REAL — docs/roadmap.md
    output: [
      "1. POST /api/session",
      "2. validateCredentials()",
      "3. createSession()",
      "4. redirect → /dashboard",
    ], // MOCK — shape matches documented ordered step list
  },
  {
    command: 'devmap explain "authentication feature"',
    query: "how does auth work",
    coreQuestion: "What does this file/feature/function do, in detail?", // REAL — docs/roadmap.md
    output: [
      "Handles session creation and validation.",
      "Imports db.ts for user lookup.",
      "Imported by 4 files. Marked critical.",
    ], // MOCK — shape matches documented prose explanation
  },
  {
    command: "devmap doctor",
    query: "why isn't this working",
    coreQuestion: "Why isn't this working?", // CONSTRUCTED
    output: [
      "DevMap version     0.1.0   ✓",
      "Provider           Groq    ✓",
      "API key            valid   ✓",
      "No issues found.",
    ], // REAL — condensed from docs/commands.md
  },
];
---

<section id="commands" class="commands-section">
  <div class="commands-section__track">
    <div class="commands-section__stage">
      <div class="commands-section__header">
        <h2 class="commands-section__title">
          Ask your codebase. The right
          <span class="commands-section__accent">command</span> answers.
        </h2>
      </div>

      <div class="command-palette" role="region" aria-label="DevMap command examples">
        <div class="command-palette__input">
          <svg
            class="command-palette__search"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <circle cx="7" cy="7" r="4.5"></circle>
            <line x1="10.5" y1="10.5" x2="13.5" y2="13.5"></line>
          </svg>
          <span class="command-palette__typed" data-typed aria-hidden="true"></span>
          <span class="command-palette__caret" aria-hidden="true"></span>
        </div>

        <ul class="command-palette__results">
          {commands.map((entry, index) => (
            <li class="command-palette__row" data-row={index}>
              <code class="command-palette__row-command">{entry.command}</code>
              <span class="command-palette__row-arrow" aria-hidden="true">→</span>
            </li>
          ))}
        </ul>

        <div class="command-palette__output" data-output aria-hidden="true"></div>
        <p class="command-palette__question" data-question aria-hidden="true"></p>
      </div>
    </div>

    <script type="application/json" id="commands-data" is:inline set:html={JSON.stringify(commands)}></script>

    <div class="commands-section__cards">
      {commands.map((entry) => (
        <article class="command-card">
          <div class="command-card__query">{entry.query}</div>
          <code class="command-card__command">{entry.command}</code>
          <div class="command-card__output">
            {entry.output.map((line) => (
              <div class="command-card__line">{line}</div>
            ))}
          </div>
          <p class="command-card__question">{entry.coreQuestion}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { staggerReveal } from "../../scripts/stagger-reveal";

  type CommandEntry = {
    command: string;
    query: string;
    coreQuestion: string;
    output: string[];
  };

  const prefersReducedMotion =
    window.matchMedia &&
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const isMobile = window.matchMedia("(max-width: 760px)").matches;

  const cards = Array.from(
    document.querySelectorAll<HTMLElement>(".command-card")
  );

  staggerReveal(cards, { y: 16, staggerMs: 80 });

  if (!prefersReducedMotion && !isMobile) {
    const dataElement = document.getElementById("commands-data");
    const typed = document.querySelector<HTMLElement>("[data-typed]");
    const rows = Array.from(
      document.querySelectorAll<HTMLElement>("[data-row]")
    );
    const output = document.querySelector<HTMLElement>("[data-output]");
    const question = document.querySelector<HTMLElement>("[data-question]");

    if (dataElement && typed && rows.length && output && question) {
      const outputEl: HTMLElement = output;
      const questionEl: HTMLElement = question;
      const commandsData = JSON.parse(
        dataElement.textContent ?? "[]"
      ) as CommandEntry[];

      gsap.registerPlugin(ScrollTrigger);

      let activeIndex = -1;
      let typedChars = 0;
      let renderedIndex = -1;

      function renderOutput(index: number) {
        const entry = commandsData[index];
        outputEl.textContent = "";
        for (const line of entry.output) {
          const lineEl = document.createElement("div");
          lineEl.className = "command-palette__line";
          lineEl.textContent = line;
          outputEl.appendChild(lineEl);
        }
        questionEl.textContent = entry.coreQuestion;
      }

      ScrollTrigger.create({
        trigger: ".commands-section__track",
        start: "top top+=75",
        end: "bottom bottom",
        pin: ".commands-section__stage",
        scrub: 1,
        onUpdate(self) {
          const totalSteps = commandsData.length;
          const raw = self.progress * totalSteps;
          const index = Math.min(Math.floor(raw), totalSteps - 1);
          const local = raw - index;

          if (index !== activeIndex) {
            activeIndex = index;
            rows.forEach((row, rowIndex) => {
              row.classList.toggle("is-active", rowIndex === index);
            });
          }

          const entry = commandsData[index];
          let nextChars: number;

          if (index > 0 && local < 0.15) {
            nextChars = Math.max(
              0,
              Math.round((1 - local / 0.15) * entry.query.length)
            );
          } else if (local < 0.55) {
            const fraction = (local - 0.15) / 0.4;
            nextChars = Math.round(
              Math.min(1, Math.max(0, fraction)) * entry.query.length
            );
          } else {
            nextChars = entry.query.length;
          }

          if (nextChars !== typedChars) {
            typedChars = nextChars;
            typed.textContent = entry.query.slice(0, typedChars);
          }

          const previewStarted = index === 0 ? local >= 0.55 : local >= 0.75;
          if (previewStarted && renderedIndex !== index) {
            renderedIndex = index;
            renderOutput(index);
          }
        },
      });
    }
  }
</script>

<style>
  .commands-section {
    padding: var(--section-spacing) 0;
    text-align: center;
  }

  .commands-section__header {
    width: min(100% - (var(--page-padding) * 2), 65rem);
    margin-inline: auto;
  }


  .commands-section__title {
    max-width: 40rem;
    margin: 0 auto 3rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  .commands-section__accent {
    color: var(--color-aqua);
  }

  .commands-section__track {
    height: calc(48vh * 7);
  }

  .command-palette {
    width: min(100% - (var(--page-padding) * 2), 42rem);
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg-soft);
    text-align: left;
  }

  .command-palette__input {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text);
  }

  .command-palette__search {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--color-text-subtle);
  }

  .command-palette__typed {
    white-space: pre;
  }

  .command-palette__caret {
    width: 7px;
    height: 1.1em;
    flex-shrink: 0;
    background: var(--color-aqua);
    opacity: 0.9;
    animation: command-caret 1.1s steps(2, start) infinite;
  }

  @keyframes command-caret {
    0%,
    49% {
      opacity: 0.9;
    }

    50%,
    100% {
      opacity: 0;
    }
  }

  .command-palette__results {
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    border-bottom: 1px solid var(--color-border);
  }

  .command-palette__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.84375rem;
    color: var(--color-text-muted);
  }

  .command-palette__row-command {
    font-family: inherit;
    color: inherit;
  }

  .command-palette__row-arrow {
    color: var(--color-text-subtle);
  }

  .command-palette__row.is-active {
    background: var(--color-aqua-soft);
    color: var(--color-text);
  }

  .command-palette__row.is-active .command-palette__row-arrow {
    color: var(--color-aqua);
  }

  .command-palette__output {
    min-height: 5.5rem;
    padding: 1.25rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .command-palette__line {
    white-space: pre;
  }

  .command-palette__question {
    margin: 0;
    padding: 0.875rem 1.5rem 1.25rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .commands-section__cards {
    display: none;
  }

  @media (max-width: 760px), (prefers-reduced-motion: reduce) {
    .commands-section__track {
      height: auto;
    }

    .command-palette {
      display: none;
    }

    .commands-section__cards {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      width: min(100% - (var(--page-padding) * 2), 42rem);
      margin: 0 auto;
    }

    .command-card {
      padding: 1.25rem 1.5rem;
      border: 1px solid var(--color-border);
      border-radius: 0.75rem;
      background: var(--color-bg-soft);
      text-align: left;
      opacity: 1;
      transform: none;
      transition: opacity 500ms ease, transform 500ms ease;
    }

    .command-card__query {
      margin: 0 0 0.875rem;
      font-family: var(--font-mono);
      font-size: 0.875rem;
      color: var(--color-text);
    }

    .command-card__command {
      display: inline-block;
      margin-bottom: 0.875rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--color-aqua);
    }

    .command-card__output {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: 0.875rem 1rem;
      border-radius: var(--radius-sm);
      background: var(--color-bg);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      line-height: 1.6;
      color: var(--color-text-muted);
    }

    .command-card__question {
      margin: 0.875rem 0 0;
      font-size: 0.84375rem;
      color: var(--color-text-muted);
    }
  }
</style>
