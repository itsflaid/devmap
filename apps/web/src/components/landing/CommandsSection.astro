---
const commands = [
  { name: "devmap init", text: "Set up DevMap for this project and choose an AI provider if you want one." },
  { name: "devmap analyze", text: "Scan the project and write the .devmap folder. Static analysis, no AI required." },
  { name: "devmap onboarding", text: "A reading order for someone new to the codebase: where to start and what to read next." },
  { name: "devmap map", text: "Show the dependency tree from the saved analysis, without scanning again." },
  { name: "devmap flow", text: "Walk a feature or request step by step, as a Mermaid diagram or in the terminal." },
  { name: "devmap explain", text: "Ask about a file or feature and get an answer grounded in the analysis. Needs an AI provider." },
  { name: "devmap doctor", text: "Check your setup and print a report you can paste into a bug report." },
  { name: "devmap config model", text: "Pick the model used by the AI-powered commands." }
];
---

<section class="commands page" id="commands" aria-labelledby="commands-title">
  <h2 class="commands__title" id="commands-title">Eight commands.</h2>

  <dl class="commands__list">
    {commands.map((command) => (
      <div class="commands__row">
        <dt><code>{command.name}</code></dt>
        <dd>{command.text}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .commands {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: var(--section-space);
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 62rem) {
    .commands {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }

    .commands__title {
      position: sticky;
      top: calc(2rem + var(--sticky-offset));
      transition: top 260ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }
  }

  .commands__title {
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .commands__list {
    margin: 0;
  }

  .commands__row {
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--rule);
    transition: border-color 150ms ease;
  }

  .commands__row:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .commands__row:hover {
    border-top-color: var(--accent);
  }

  @media (min-width: 40rem) {
    .commands__row {
      grid-template-columns: 13.5rem minmax(0, 1fr);
    }
  }

  .commands__row dt {
    color: var(--ink);
  }

  .commands__row code {
    font-size: 0.9375rem;
  }

  .commands__row dd {
    margin: 0;
    color: var(--text);
  }
</style>
