---

const metrics = [
  { metric: "How structure is found", without: "Agent infers by reading code, live", with: "Static analysis (AST), computed once" },
  { metric: "What gets sent to AI", without: "Whatever the agent decides to read", with: "Curated index + feature map, not full source" },
  { metric: "Context per session", without: "Rebuilt from scratch", with: "Cached snapshot, reused" },
  { metric: "Starting a new session", without: "No starting point", with: "Ordered reading path, with reasons" },
  { metric: "Works across AI tools", without: "Re-explained per tool", with: "One snapshot, every agent" },
];
---

<section id="comparison" class="landing-section comparison-section">
  <h2 class="comparison-section__title">DevMap vs. Going in blind</h2>

  <div class="comparison-section__table-wrap">
    <table class="comparison-table">
      <thead>
        <tr>
          <th scope="col" class="comparison-table__metric-head"></th>
          <th scope="col" class="comparison-table__head">Without DevMap</th>
          <th scope="col" class="comparison-table__head">With DevMap</th>
        </tr>
      </thead>
      <tbody>
        {metrics.map((row) => (
          <tr>
            <th scope="row" class="comparison-table__metric">
              {row.metric}
            </th>
            <td class="comparison-table__without">{row.without}</td>
            <td class="comparison-table__with">{row.with}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { revealOnScroll } from "../../scripts/scroll-reveal";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion =
    window.matchMedia &&
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const section = document.querySelector<HTMLElement>(".comparison-section");

  revealOnScroll(section, ".comparison-section__title", { y: 16 });

  // Bespoke reveal instead of the shared stagger: each row fades up as
  // usual, but the "With DevMap" cell also gets an aqua accent border
  // that draws in right after — so the winning column visibly "lights
  // up" row by row instead of both columns just appearing identically.
  if (section && !prefersReducedMotion) {
    const rows = Array.from(
      section.querySelectorAll<HTMLElement>(".comparison-table tbody tr")
    );

    if (rows.length) {
      gsap.set(rows, { opacity: 0, y: 18 });

      const tl = gsap.timeline({
        scrollTrigger: { trigger: section, start: "top 78%", once: true },
      });

      rows.forEach((row, index) => {
        const withCell = row.querySelector<HTMLElement>(
          ".comparison-table__with"
        );
        if (withCell) gsap.set(withCell, { borderInlineStartColor: "transparent" });

        const position = index === 0 ? undefined : "-=0.32";
        tl.to(
          row,
          { opacity: 1, y: 0, duration: 0.45, ease: "power2.out" },
          position
        );

        if (withCell) {
          tl.to(
            withCell,
            { borderInlineStartColor: "#2ee6d6", duration: 0.35, ease: "power1.out" },
            "-=0.15"
          );
        }
      });
    }
  }
</script>

<style>
  .comparison-section {
    padding: var(--section-spacing) 0;
    text-align: center;
  }

  .comparison-section__title {
    margin: 0 0 3rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  .comparison-section__table-wrap {
    max-width: 52rem;
    margin: 0 auto;
    overflow-x: auto;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.9375rem;
  }

  .comparison-table__head {
    padding: 0 1.25rem 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .comparison-table__metric-head {
    padding: 0 1.25rem 0.875rem;
  }

  .comparison-table th,
  .comparison-table td {
    border-bottom: 1px solid var(--color-border);
  }

  .comparison-table tbody tr:last-child th,
  .comparison-table tbody tr:last-child td {
    border-bottom: none;
  }

  .comparison-table__metric {
    padding: 1rem 1.25rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .comparison-table__without {
    padding: 1rem 1.25rem;
    color: var(--color-text-subtle);
  }

  .comparison-table__with {
    padding: 1rem 1.25rem;
    border-inline-start: 2px solid transparent;
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .comparison-table {
      font-size: 0.8125rem;
    }

    .comparison-table__metric,
    .comparison-table__without,
    .comparison-table__with {
      padding: 0.875rem 0.75rem;
    }

    .comparison-table__head {
      padding: 0 0.75rem 0.75rem;
    }
  }
</style>
