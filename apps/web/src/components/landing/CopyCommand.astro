---
interface Props {
  command: string;
  size?: "base" | "large";
  tone?: "light" | "dark";
}

const { command, size = "base", tone = "light" } = Astro.props;
---

<div class:list={["copy", `copy--${size}`, `copy--${tone}`]}>
  <code class="copy__line">
    <span class="copy__prompt" aria-hidden="true">$</span>
    <span class="copy__text">{command}</span>
  </code>
  <button type="button" class="copy__button" aria-label={`Copy ${command}`}>
    <svg class="copy__icon copy__icon--copy" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
      <rect x="5.25" y="5.25" width="8" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5" />
      <path d="M10.75 3.5v-.25A1.5 1.5 0 0 0 9.25 1.75h-5.5a1.5 1.5 0 0 0-1.5 1.5v5.5a1.5 1.5 0 0 0 1.5 1.5H4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
    <svg class="copy__icon copy__icon--check" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
      <path d="m3 8.5 3.25 3.25L13 4.75" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span class="copy__label">
      <span class="copy__idle">Copy</span>
      <span class="copy__done" aria-hidden="true">Copied</span>
    </span>
  </button>
</div>

<script>
  import { initCopyCommand } from "../../scripts/copy-command";

  document.querySelectorAll<HTMLElement>(".copy").forEach((root) => {
    const button = root.querySelector<HTMLElement>(".copy__button");
    const text = root.querySelector<HTMLElement>(".copy__text");
    if (button && text) initCopyCommand(button, text);
  });
</script>

<style>
  /*
   * A pill holding one command. The whole pill is the click target (the
   * button stretches over it) and the border turns blue on hover.
   */
  .copy {
    --copy-bg: var(--surface);
    --copy-border: var(--rule-strong);
    --copy-text: var(--ink);
    --copy-muted: var(--muted);

    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    width: min(100%, 28rem);
    padding: 0.7rem 0.8rem 0.7rem 1.25rem;
    border: 1px solid var(--copy-border);
    border-radius: 999px;
    background: var(--copy-bg);
    transition: border-color 150ms ease;
  }

  .copy--dark {
    --copy-bg: var(--night-2);
    --copy-border: var(--night-rule);
    --copy-text: #fff;
    --copy-muted: var(--night-muted);
  }

  .copy:hover,
  .copy:has(.copy__button:focus-visible) {
    border-color: var(--accent);
  }

  .copy__line {
    min-width: 0;
    font-size: 0.9375rem;
    color: var(--copy-text);
    overflow-wrap: anywhere;
  }

  .copy__prompt {
    margin-right: 0.9ch;
    color: var(--copy-muted);
  }

  .copy__button {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--copy-muted);
    font-family: var(--font-body);
    font-size: 0.875rem;
    cursor: pointer;
    transition: color 150ms ease;
  }

  /* Stretch the hit area over the whole pill. */
  .copy__button::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 999px;
  }

  .copy__button:focus-visible {
    outline: none;
  }

  .copy__button:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .copy:hover .copy__button {
    color: var(--accent);
  }

  .copy--dark:hover .copy__button {
    color: #fff;
  }

  .copy__icon {
    flex: none;
  }

  .copy__icon--check,
  .copy__done,
  .copy__button[data-copied] .copy__icon--copy,
  .copy__button[data-copied] .copy__idle {
    display: none;
  }

  .copy__button[data-copied] {
    color: var(--accent);
  }

  .copy--dark .copy__button[data-copied] {
    color: var(--ok);
  }

  .copy__button[data-copied] .copy__icon--check {
    display: block;
  }

  .copy__button[data-copied] .copy__done {
    display: inline;
  }

  /* Large: the command is the headline of its section. */
  .copy--large {
    width: min(100%, 38rem);
    padding: 1rem 1.1rem 1rem 1.6rem;
  }

  .copy--large .copy__line {
    font-size: clamp(0.9375rem, 3.6vw, 1.25rem);
  }

  .copy--large .copy__button {
    font-size: 0.9375rem;
  }

  @media (max-width: 40rem) {
    .copy {
      gap: 0.75rem;
      padding-left: 1rem;
    }

    .copy__line {
      font-size: 0.8125rem;
    }
  }
</style>
