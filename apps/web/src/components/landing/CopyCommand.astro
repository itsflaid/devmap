---
interface Props {
  command: string;
  size?: "base" | "large";
  tone?: "light" | "dark";
}

const { command, size = "base", tone = "light" } = Astro.props;
---

<!--
  Modeled on the install box on npmjs.com: a flat rectangle holding the command
  in monospace, with an icon-only copy button in its own cell on the right. Only
  the button copies, so the command text can still be selected by hand.
-->
<div class:list={["copy", `copy--${size}`, `copy--${tone}`]}>
  <code class="copy__line"><span class="copy__text">{command}</span></code>
  <button type="button" class="copy__button" aria-label={`Copy ${command}`}>
    <svg class="copy__icon copy__icon--copy" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
      <rect x="5.25" y="5.25" width="8" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5" />
      <path d="M10.75 3.5v-.25A1.5 1.5 0 0 0 9.25 1.75h-5.5a1.5 1.5 0 0 0-1.5 1.5v5.5a1.5 1.5 0 0 0 1.5 1.5H4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
    <svg class="copy__icon copy__icon--check" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
      <path d="m3 8.5 3.25 3.25L13 4.75" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span class="copy__tip" aria-hidden="true">Copied</span>
  </button>
</div>

<script>
  import { initCopyCommand } from "../../scripts/copy-command";

  document.querySelectorAll<HTMLElement>(".copy").forEach((root) => {
    const button = root.querySelector<HTMLElement>(".copy__button");
    const text = root.querySelector<HTMLElement>(".copy__text");
    if (button && text) initCopyCommand(button, text);
  });
</script>

<style>
  .copy {
    --copy-bg: var(--surface);
    --copy-border: var(--rule-strong);
    --copy-text: var(--ink);
    --copy-muted: var(--muted);
    --copy-hover: var(--paper);

    display: flex;
    align-items: stretch;
    width: min(100%, 26rem);
    border: 1px solid var(--copy-border);
    border-radius: 0.5rem;
    background: var(--copy-bg);
  }

  .copy--dark {
    --copy-bg: var(--night-2);
    --copy-border: var(--night-rule);
    --copy-text: #fff;
    --copy-muted: var(--night-muted);
    --copy-hover: rgba(255, 255, 255, 0.06);
  }

  .copy__line {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    padding: 0.8rem 1rem;
    font-size: 0.9375rem;
    color: var(--copy-text);
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
  }

  .copy__line::-webkit-scrollbar {
    display: none;
  }

  .copy__button {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    padding: 0;
    border: 0;
    border-left: 1px solid var(--copy-border);
    border-radius: 0 0.4375rem 0.4375rem 0;
    background: none;
    color: var(--copy-muted);
    cursor: pointer;
    transition:
      background 150ms ease,
      color 150ms ease;
  }

  .copy__button:hover {
    background: var(--copy-hover);
    color: var(--copy-text);
  }

  .copy__button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .copy__icon--check,
  .copy__button[data-copied] .copy__icon--copy {
    display: none;
  }

  .copy__button[data-copied] .copy__icon--check {
    display: block;
  }

  .copy__button[data-copied] {
    color: var(--ok);
  }

  .copy:not(.copy--dark) .copy__button[data-copied] {
    color: #15803d;
  }

  /* "Copied" tooltip above the button, like npm's. */
  .copy__tip {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.5rem);
    padding: 0.25rem 0.6rem;
    border-radius: 0.4rem;
    background: var(--ink);
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.75rem;
    line-height: 1.3;
    opacity: 0;
    pointer-events: none;
    translate: 0 0.25rem;
    transition:
      opacity 150ms ease,
      translate 150ms ease;
  }

  .copy--dark .copy__tip {
    background: #fff;
    color: var(--ink);
  }

  .copy__button[data-copied] .copy__tip {
    opacity: 1;
    translate: 0 0;
  }

  /* Large: the command is the headline of its section. */
  .copy--large {
    width: min(100%, 34rem);
  }

  .copy--large .copy__line {
    padding: 1.1rem 1.4rem;
    font-size: clamp(0.9375rem, 3.4vw, 1.25rem);
  }

  .copy--large .copy__button {
    width: 3.75rem;
  }

  @media (max-width: 40rem) {
    .copy__line {
      font-size: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .copy__tip {
      transition: none;
    }
  }
</style>
