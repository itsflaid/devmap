---
---

<section id="features" class="engine-section">
  <p class="engine-section__eyebrow">How it works</p>

  <div class="engine-section__grid">
    <div class="engine-section__col engine-section__col--static">
      <div class="engine-section__col-inner">
        <p class="engine-section__label">Static analysis</p>
        <p class="engine-section__stat">80%</p>
        <p class="engine-section__line">
          One <code>analyze</code> pass builds the whole picture,
          structure, routes, dependencies, critical files, once.
        </p>
      </div>
    </div>

    <div class="engine-section__col engine-section__col--ai">
      <div class="engine-section__col-inner">
        <p class="engine-section__label">AI</p>
        <p class="engine-section__stat">20%</p>
        <p class="engine-section__line">
          Wherever a model is involved, enrichment, narration, answers,
          it reads that snapshot instead of your raw code.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { revealOnScroll } from "../../scripts/scroll-reveal";

  const section = document.querySelector<HTMLElement>(".engine-section");

  revealOnScroll(section, ".engine-section__eyebrow", { y: 12 });
  revealOnScroll(
    section,
    ".engine-section__col--static .engine-section__label, .engine-section__col--static .engine-section__stat, .engine-section__col--static .engine-section__line",
    { y: 16, stagger: 0.08 }
  );
  revealOnScroll(
    section,
    ".engine-section__col--ai .engine-section__label, .engine-section__col--ai .engine-section__stat, .engine-section__col--ai .engine-section__line",
    { y: 16, stagger: 0.08 }
  );
</script>

<style>
  .engine-section {
    padding-top: var(--section-spacing);
  }

  .engine-section__eyebrow {
    margin: 0 0 2rem;
    padding: 0 var(--page-padding);
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .engine-section__grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 760px) {
    .engine-section__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .engine-section__col {
    padding: clamp(3rem, 7vw, 5rem) var(--page-padding);
  }

  .engine-section__col--ai {
    background: var(--color-bg-invert);
    color: var(--color-text-invert);
  }

  .engine-section__col--ai :focus-visible {
    outline-color: var(--color-text-invert);
  }

  .engine-section__col-inner {
    max-width: 22rem;
  }

  .engine-section__label {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .engine-section__col--ai .engine-section__label {
    color: var(--color-text-invert-muted);
  }

  .engine-section__stat {
    margin: 0 0 1rem;
    font-size: clamp(2.5rem, 7vw, 4rem);
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  .engine-section__col--static .engine-section__stat {
    color: var(--color-aqua);
  }

  .engine-section__line {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .engine-section__col--ai .engine-section__line {
    color: var(--color-text-invert-muted);
  }

  .engine-section__line code {
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: 0.8125em;
    color: var(--color-text);
  }

  .engine-section__col--ai .engine-section__line code {
    border-color: var(--color-border-invert-strong);
    background: #ffffff;
    color: var(--color-text-invert);
  }
</style>
