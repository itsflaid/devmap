---
import CopyCommand from "./CopyCommand.astro";
---

<section class="hero page" id="top">
  <h1 class="hero__title">
    <span class="hero__line"><span>Analyze once.</span></span>
    <span class="hero__line"><span>Reuse context</span></span>
    <span class="hero__line"><span>everywhere.</span></span>
  </h1>

  <p class="hero__lede">
    DevMap reads your codebase and writes a map that developers and AI agents
    can start from: entry points, critical files, features and routes.
  </p>

  <div class="hero__install">
    <CopyCommand command="npm install -g @flaid/devmap" />
    <a class="link" href="https://github.com/itsflaid/devmap">Source on GitHub</a>
  </div>

  <p class="hero__note">Needs Node 22 or newer. No account or API key to analyze.</p>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 9vw, 7rem) var(--section-space);
  }

  .hero__title {
    font-size: clamp(3.25rem, 11.2vw, 10.5rem);
    line-height: 0.93;
    letter-spacing: -0.04em;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    /* room for descenders so the reveal mask does not clip the "y" */
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .hero__line > span {
    display: block;
    animation: rise 800ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero__line:nth-child(2) > span {
    animation-delay: 90ms;
  }

  .hero__line:nth-child(3) > span {
    animation-delay: 180ms;
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
    to {
      transform: translateY(0);
    }
  }

  .hero__lede {
    max-width: 34rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.4;
    color: var(--ink);
  }

  .hero__install {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 2rem;
  }

  .hero__note {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__line > span {
      animation: none;
    }
  }
</style>
