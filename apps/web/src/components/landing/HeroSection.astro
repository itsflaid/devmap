---

const indexRows = [
  {
    path: "lib/auth.ts",
    reason: "critical · referenced by 4 files",
    critical: true,
  },
  {
    path: "lib/db.ts",
    reason: "data access layer",
    critical: false,
  },
  {
    path: "app/api/session/route.ts",
    reason: "entry point",
    critical: false,
  },
  {
    path: "prisma/schema.prisma",
    reason: "schema source",
    critical: false,
  },
];
---

<section id="hero" class="hero">
  <div class="hero__inner">
    <p class="hero__eyebrow">
      <span class="hero__eyebrow-dot" aria-hidden="true"></span>
      Open source · Local-first CLI
    </p>

    <h1 class="hero__title">
      Analyze once.<br />
      Reuse context <span class="hero__title-accent">everywhere.</span>
    </h1>

    <p class="hero__subhead">
      devmap scans your project once, routes, dependencies, entry points,
      critical files, into a structured snapshot, so you stop re-explaining
      your codebase to every AI agent, every session.
    </p>

    <div class="hero__cta-row">
      <button type="button" class="cta-primary">
        <span class="cta-prompt" aria-hidden="true">$</span>
        npm install -g @flaid/devmap
      </button>
      <a class="cta-secondary" href="https://github.com/itsflaid/devmap">
        View on GitHub →
      </a>
    </div>

    <p class="hero__meta-line">
      MIT licensed. No account or API key required to start.
    </p>

    <div class="index-panel">
      <div class="index-panel__header">
        <span class="index-panel__cmd">devmap analyze</span>
      </div>

      <div class="index-list">
        {indexRows.map((row) => (
          <div class="index-row">
            <div class="index-row__rail">
              <span
                class:list={[
                  "index-row__dot",
                  { "index-row__dot--critical": row.critical },
                ]}
                aria-hidden="true"
              ></span>
              <span class="index-row__line" aria-hidden="true"></span>
            </div>
            <div class="index-row__content">
              <div class="index-row__path">{row.path}</div>
              <div class="index-row__reason">{row.reason}</div>
            </div>
          </div>
        ))}
      </div>

      <p class="index-panel__caption">
        One snapshot. Reused by every question after this.
      </p>
    </div>
  </div>
</section>

<script>
  import { staggerReveal } from "../../scripts/stagger-reveal";

  staggerReveal(document.querySelectorAll<HTMLElement>(".index-row"), {
    y: 10,
    staggerMs: 90,
  });
</script>

<style>
  .hero {
    padding: 6rem 0 4.5rem;
  }

  .hero__inner {
    width: min(100% - (var(--page-padding) * 2), 65rem);
    margin-inline: auto;
    text-align: center;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .hero__eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-aqua);
  }

  .hero__title {
    margin: 0 0 1.25rem;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  .hero__title-accent {
    color: var(--color-aqua);
  }

  .hero__subhead {
    max-width: 34rem;
    margin: 0 auto 2.25rem;
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .hero__cta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .hero__meta-line {
    margin: 0 0 4.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--color-text-subtle);
  }

  .index-panel {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg-soft);
    text-align: left;
  }

  .index-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-subtle);
  }

  .index-panel__cmd {
    color: var(--color-text-muted);
  }

  .index-list {
    padding: 1.75rem 1.5rem 0.5rem;
  }

  .index-row {
    display: flex;
    gap: 1rem;
    opacity: 1;
    transform: none;
    transition: opacity 500ms ease, transform 500ms ease;
  }

  .index-row__rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 10px;
  }

  .index-row__dot {
    width: 9px;
    height: 9px;
    flex-shrink: 0;
    margin-top: 5px;
    border-radius: 50%;
    background: var(--color-border-strong);
  }

  .index-row__dot--critical {
    background: var(--color-aqua);
    box-shadow: 0 0 0 3px var(--color-aqua-soft);
  }

  .index-row__line {
    flex: 1;
    width: 1px;
    margin: 4px 0;
    background: var(--color-border-strong);
  }

  .index-row__content {
    padding-bottom: 1.625rem;
  }

  .index-row:last-child .index-row__content {
    padding-bottom: 0.25rem;
  }

  .index-row:last-child .index-row__line {
    display: none;
  }

  .index-row__path {
    margin-bottom: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.84375rem;
    color: var(--color-text);
  }

  .index-row__reason {
    font-size: 0.8125rem;
    color: var(--color-text-subtle);
  }

  .index-panel__caption {
    margin: 0.25rem 0 0;
    padding: 0.875rem 1.5rem 1.25rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .hero {
      margin-top: 20px;
      padding: 3.5rem 0 3rem;
    }

    .hero__meta-line {
      margin-bottom: 3rem;
    }
  }
</style>
