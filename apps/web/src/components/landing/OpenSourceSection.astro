---

const supportLinks = [
  { label: "Ko-fi", href: "https://ko-fi.com/itsflaid" },
  { label: "GitHub Sponsors", href: "https://github.com/sponsors/itsflaid" },
];
---

<section id="open-source" class="open-source-section open-source-section--light">
  <div class="landing-section open-source-section__inner">
    <h2 class="open-source-section__title">Free. Open Source. Forever.</h2>

    <p class="open-source-section__copy">
      DevMap is MIT licensed and free to use. No subscription. No account
      required. No DevMap servers involved.
    </p>

    <p class="open-source-section__copy open-source-section__copy--last">
      If DevMap saves you time, consider supporting development.
    </p>

    <div class="open-source-section__links">
      {supportLinks.map((link) => (
        <a class="open-source-section__link" href={link.href}>
          {link.label} →
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  import { revealOnScroll } from "../../scripts/scroll-reveal";

  const section = document.querySelector<HTMLElement>(".open-source-section");

  revealOnScroll(
    section,
    ".open-source-section__title, .open-source-section__copy",
    { y: 14, stagger: 0.1 }
  );
  revealOnScroll(section, ".open-source-section__link", {
    y: 12,
    stagger: 0.1,
    start: "top 80%",
  });
</script>

<style>
  .open-source-section--light {
    --os-bg: #f5f6f7;
    --os-text: #10151b;
    --os-text-muted: #4b5563;
    --os-border-strong: rgba(15, 20, 25, 0.16);

    background: var(--os-bg);
    color: var(--os-text);
  }

  .open-source-section--light :focus-visible {
    outline-color: var(--os-text);
  }

  .open-source-section__inner {
    padding: var(--section-spacing) 0;
    text-align: center;
  }

  .open-source-section__title {
    margin: 0 0 1.25rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  .open-source-section__copy {
    max-width: 34rem;
    margin: 0 auto 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--os-text-muted);
  }

  .open-source-section__copy--last {
    margin-bottom: 2rem;
  }

  .open-source-section__links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .open-source-section__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--os-text-muted);
    border-bottom: 1px solid transparent;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .open-source-section__link:hover {
    color: var(--os-text);
    border-color: var(--os-border-strong);
  }
</style>
