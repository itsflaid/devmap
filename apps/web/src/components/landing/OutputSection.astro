---
// Excerpt of the .devmap/index.json that `devmap analyze` wrote for this
// repository. Lines marked `hot` are the ones an agent reads first.
const lines: Array<{ text: string; hot?: boolean }> = [
  { text: "{" },
  { text: '  "project": {' },
  { text: '    "name": "devmap-workspace",' },
  { text: '    "framework": "astro",' },
  { text: '    "language": "typescript",' },
  { text: '    "workspaceType": "monorepo"' },
  { text: "  }," },
  { text: '  "entryPoints": [', hot: true },
  { text: '    "packages/cli/src/index.ts",', hot: true },
  { text: '    "apps/web/src/pages/docs.astro",', hot: true },
  { text: '    "apps/web/src/pages/index.astro"', hot: true },
  { text: "  ],", hot: true },
  { text: '  "criticalFiles": [' },
  { text: '    "packages/cli/src/commands/analyze.ts",' },
  { text: '    "packages/cli/src/commands/init.ts",' },
  { text: '    "packages/cli/src/commands/map.ts"' },
  { text: "  ]," },
  { text: '  "features": [' },
  { text: "    {" },
  { text: '      "name": "CLI Commands",' },
  { text: '      "map": ".devmap/features/cli-commands.json"' },
  { text: "    }" },
  { text: "  ]" },
  { text: "}" }
];

const files = [
  { name: "index.json", note: "Start here. Entry points, critical files and a pointer to each feature." },
  { name: "features/*.json", note: "One map per feature, with the files that implement it." },
  { name: "snapshot.json", note: "The full analysis, read only when the two above are not enough." }
];
---

<section class="output section page" aria-labelledby="output-title">
  <div class="output__intro" data-reveal>
    <p class="eyebrow"><span class="eyebrow__dot"></span>Output</p>
    <h2 class="section__title output__title" id="output-title">
      Your project, as files an agent can read.
    </h2>
    <p class="output__copy">
      <code>devmap analyze</code> writes a <code>.devmap</code> folder next to
      your code. Agents open the small index first and follow it to the one
      feature they need, instead of exploring the whole repository.
    </p>

    <ol class="output__files">
      {files.map((file, i) => (
        <li>
          <span class="output__n">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <code>.devmap/{file.name}</code>
            <p>{file.note}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>

  <figure class="output__figure" data-reveal style="--i:2">
    <div class="code-card">
      <div class="code-card__bar">
        <span></span><span></span><span></span>
        <b>.devmap/index.json</b>
        <i>highlighted: entry points</i>
      </div>
      <pre class="code" tabindex="0"><code>{lines.map((line) => (
        <span class:list={["code__line", { "code__line--hot": line.hot }]}>{line.text}</span>
      ))}</code></pre>
    </div>
    <figcaption>Trimmed, from analyzing this repository.</figcaption>
  </figure>
</section>

<style>
  .output {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .output {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  .output__intro {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  .output__title {
    max-width: 11em;
  }

  .output__copy {
    max-width: 30rem;
    color: var(--muted);
  }

  .output__copy code {
    font-size: 0.875em;
    color: var(--ink);
  }

  .output__files {
    display: grid;
    width: 100%;
    max-width: 32rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .output__files li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.5rem;
    padding-block: 1rem;
    border-top: 1px solid var(--rule);
  }

  .output__files li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .output__n {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding-top: 0.2rem;
    color: var(--muted);
  }

  .output__files code {
    font-size: 0.875rem;
    color: var(--ink);
  }

  .output__files p {
    margin-top: 0.25rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .output__figure {
    margin: 0;
    min-width: 0;
  }

  .output__figure figcaption {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-align: right;
    color: var(--muted);
  }

  .code-card {
    overflow: hidden;
    border: 1px solid var(--night-rule);
    border-radius: var(--radius-lg);
    background: var(--night);
    box-shadow: 0 30px 60px -30px rgba(20, 19, 17, 0.55);
  }

  .code-card__bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--night-rule);
  }

  .code-card__bar span {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
  }

  .code-card__bar b {
    margin-left: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--night-text);
  }

  .code-card__bar i {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-style: normal;
    color: #7aa7ff;
  }

  .code {
    margin: 0;
    padding: 1.1rem 0;
    font-size: clamp(0.72rem, 1.5vw, 0.84rem);
    line-height: 1.75;
    color: var(--night-text);
    overflow-x: auto;
    counter-reset: line;
  }

  .code code {
    display: block;
    width: max-content;
    min-width: 100%;
  }

  .code__line {
    display: block;
    padding-inline: 1.1rem 1.5rem;
    border-left: 3px solid transparent;
    white-space: pre;
    counter-increment: line;
  }

  .code__line::before {
    content: counter(line);
    display: inline-block;
    width: 2.25ch;
    margin-right: 2ch;
    text-align: right;
    color: #5d5a53;
    user-select: none;
  }

  .code__line--hot {
    border-left-color: #7aa7ff;
    background: rgba(122, 167, 255, 0.1);
    color: #fff;
  }
</style>
