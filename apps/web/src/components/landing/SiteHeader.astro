---
const navigationItems = [
  { href: "#problem", label: "Problem" },
  { href: "#how-it-works", label: "How It Works" },
  { href: "#features", label: "Features" },
  { href: "#ai-agents", label: "AI Agents" },
  { href: "#comparison", label: "Comparison" }
];
---

<header class="site-header">
  <nav class="site-header__nav" aria-label="Primary navigation">
    <a class="site-header__brand" href="#hero" aria-label="DevMap home">
      <img src="/logo-devmap.png" alt="" width="22" height="22" />
      dev<span class="site-header__brand-accent">map</span>
    </a>

    <div class="site-header__links">
      {navigationItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 50;
    border-block-end: 1px solid var(--color-border);
    background: rgba(10, 13, 17, 0.82);
    backdrop-filter: blur(18px);
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100% - (var(--page-padding) * 2), var(--page-max-width));
    min-height: 4rem;
    margin-inline: auto;
    gap: 1.5rem;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .site-header__brand-accent {
    color: var(--color-aqua);
  }

  .site-header__links {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  .site-header__links a {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    transition: color 150ms ease;
  }

  .site-header__links a:hover {
    color: var(--color-text);
  }

  @media (max-width: 760px) {
    .site-header__nav {
      flex-direction: column;
      justify-content: center;
      gap: 0.5rem;
      padding-block: 0.75rem;
    }

    .site-header__links {
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 0.5rem;
    }
  }
</style>
