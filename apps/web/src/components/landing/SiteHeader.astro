---
const links = [
  { href: "/#commands", label: "Commands" },
  { href: "/docs", label: "Docs" },
  { href: "https://github.com/itsflaid/devmap", label: "GitHub" }
];
---

<header class="header page">
  <a class="header__brand" href="/" aria-label="DevMap home">
    <img src="/logo-mark.png" alt="" width="28" height="28" />
    <span>devmap</span>
  </a>

  <nav class="header__nav" aria-label="Primary">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 5rem;
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .header__brand img {
    display: block;
  }

  .header__nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
    font-size: 0.9375rem;
  }

  .header__nav a {
    padding-block: 0.5rem;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
    transition: text-decoration-color 150ms ease;
  }

  .header__nav a:hover {
    color: var(--ink);
    text-decoration-color: var(--accent);
  }
</style>
