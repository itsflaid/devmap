---
import "../styles/global.css";

interface Props {
  description?: string;
  title?: string;
}

const {
  description = "DevMap analyzes your codebase once and writes a map of entry points, critical files and features that developers and AI agents can start from.",
  title = "DevMap: analyze once, reuse context everywhere"
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <title>{title}</title>
    <meta name="google-site-verification" content="GBAKYaOoWG8RG-vNSPAfDngKaM3j0efT0Mv_dy91CSI" />
  </head>
  <body>
    <slot />
  </body>
</html>
