---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import DocsSidebar from "../components/docs/DocsSidebar.astro";
import SiteFooter from "../components/landing/SiteFooter.astro";
import SiteHeader from "../components/landing/SiteHeader.astro";
import "../styles/docs-prose.css";

const entry = await getEntry("docs", "overview");
if (!entry) throw new Error("docs/overview.md entry not found");
const { Content, headings } = await render(entry);
---

<BaseLayout title={entry.data.title}>
  <SiteHeader />
  <div class="docs-page">
    <aside class="docs-sidebar-slot">
      <DocsSidebar headings={headings} />
    </aside>
    <main class="docs-content docs-prose">
      <Content />
    </main>
  </div>
  <SiteFooter />
</BaseLayout>

<style>
  .docs-page {
    width: min(100% - (var(--gutter) * 2), var(--page-max));
    margin-inline: auto;
    padding-block: 1.5rem 5rem;
  }

  @media (min-width: 760px) {
    .docs-page {
      display: grid;
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: clamp(3rem, 8vw, 7rem);
    }

    .docs-content {
      max-width: 44rem;
    }
  }
</style>
