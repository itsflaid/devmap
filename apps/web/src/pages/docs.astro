---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import DocsSidebar from "../components/docs/DocsSidebar.astro";
import SiteFooter from "../components/landing/SiteFooter.astro";
import SiteHeader from "../components/landing/SiteHeader.astro";
import "../styles/docs-prose.css";
import { SITE } from "../lib/site";

const entry = await getEntry("docs", "overview");
if (!entry) throw new Error("docs/overview.md entry not found");
const { Content, headings } = await render(entry);

const description = entry.data.description;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: entry.data.title,
    description,
    url: `${SITE.url}/docs`,
    inLanguage: "en",
    author: { "@type": "Person", name: SITE.author, url: SITE.authorUrl },
    publisher: { "@type": "Person", name: SITE.author, url: SITE.authorUrl },
    about: { "@type": "SoftwareApplication", name: SITE.name, url: `${SITE.url}/` }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: SITE.name, item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Docs", item: `${SITE.url}/docs` }
    ]
  }
];
---

<BaseLayout title={entry.data.title} description={description} type="article" jsonLd={jsonLd}>
  <SiteHeader />
  <div class="docs-page">
    <aside class="docs-sidebar-slot">
      <DocsSidebar headings={headings} />
    </aside>
    <main class="docs-content docs-prose">
      <Content />
    </main>
  </div>
  <SiteFooter />
</BaseLayout>

<style>
  .docs-page {
    width: min(100% - (var(--gutter) * 2), var(--page-max));
    margin-inline: auto;
    padding-block: 1.5rem 5rem;
  }

  /*
   * Below the grid breakpoint the slot only wraps the mobile contents bar.
   * Letting its children belong to .docs-page gives that bar the full page
   * height to stick within; as a box of its own it would never stick.
   */
  @media (max-width: 759px) {
    .docs-sidebar-slot {
      display: contents;
    }
  }

  @media (min-width: 760px) {
    .docs-page {
      display: grid;
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: clamp(3rem, 8vw, 7rem);
    }

    .docs-content {
      max-width: 44rem;
    }
  }
</style>
