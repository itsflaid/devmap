---
import AiAgentsSection from "../components/landing/AiAgentsSection.astro";
import CommandsSection from "../components/landing/CommandsSection.astro";
import ComparisonSection from "../components/landing/ComparisonSection.astro";
import FeaturesSection from "../components/landing/FeaturesSection.astro";
import FooterCtaSection from "../components/landing/FooterCtaSection.astro";
import HeroSection from "../components/landing/HeroSection.astro";
import HowItWorksSection from "../components/landing/HowItWorksSection.astro";
import OnboardingSection from "../components/landing/OnboardingSection.astro";
import OpenSourceSection from "../components/landing/OpenSourceSection.astro";
import ProblemSection from "../components/landing/ProblemSection.astro";
import SiteFooter from "../components/landing/SiteFooter.astro";
import SiteHeader from "../components/landing/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="landing-page">
    <!--
      PAGE STRUCTURE

      01. Header
      02. Hero - pahami codebase dalam menit
      03. Problem - AI menulis kode lebih cepat dari developer memahaminya
      04. How It Works - tiga command untuk full understanding
      05. Features - static analysis dahulu, AI untuk interpretasi
      06. For AI Agents - agent membutuhkan project map
      07. Commands - command palette menjawab pertanyaan kodebase
      08. Onboarding - developer tahu harus mulai dari mana
      09. Comparison - dengan DevMap versus going in blind
      10. Open Source - gratis selamanya, dukungan opsional
      11. Footer CTA - install DevMap dan baca dokumentasi
      12. Footer
    -->
    <SiteHeader />

    <main>
      <HeroSection />
      <ProblemSection />
      <HowItWorksSection />
      <FeaturesSection />
      <AiAgentsSection />
      <CommandsSection />
      <OnboardingSection />
      <ComparisonSection />
      <OpenSourceSection />
      <FooterCtaSection />
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
