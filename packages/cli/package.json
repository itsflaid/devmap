{
  "name": "@flaid/devmap",
  "mcpName": "io.github.itsflaid/devmap",
  "version": "0.8.4",
  "description": "CLI that maps your codebase into a reusable context layer for developers and AI agents: entry points, critical files, features and routes for JS/TS projects.",
  "bin": {
    "devmap": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "pnpm run test:unit && pnpm run test:types",
    "test:unit": "tsx test/run-tests.ts",
    "test:types": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "devmap",
    "ai",
    "ai-agents",
    "llm",
    "cli",
    "codebase",
    "codebase-map",
    "code-analysis",
    "static-analysis",
    "developer-tools",
    "architecture",
    "onboarding",
    "reverse-engineering",
    "context",
    "claude-code",
    "typescript",
    "nextjs",
    "route-detection",
    "feature-detection",
    "groq",
    "openrouter"
  ],
  "author": "Muhammad Fadil",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsflaid/devmap.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/itsflaid/devmap/issues"
  },
  "homepage": "https://devmap-web.vercel.app",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "ignore": "^7.0.12",
    "p-limit": "^7.3.3",
    "ts-morph": "^28.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
