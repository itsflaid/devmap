{
  "name": "@devmap/cli",
  "version": "0.1.0",
  "description": "DevMap command line interface.",
  "bin": {
    "devmap": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run test:unit && pnpm run test:types",
    "test:unit": "tsx test/run-tests.ts",
    "test:types": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "devmap",
    "cli",
    "static-analysis"
  ],
  "author": "itsflaid",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
