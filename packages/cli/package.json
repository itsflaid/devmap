{
  "name": "devmap",
  "version": "0.1.0",
  "description": "AI-powered CLI to analyze, map, and explain codebases.",
  "bin": {
    "devmap": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "test": "pnpm run test:unit && pnpm run test:types",
    "test:unit": "tsx test/run-tests.ts",
    "test:types": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "devmap",
    "ai",
    "cli",
    "codebase",
    "code-analysis",
    "developer-tools",
    "static-analysis",
    "architecture",
    "groq",
    "openrouter"
  ],
  "author": "Muhammad Fadil",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsflaid/devmap.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/itsflaid/devmap/issues"
  },
  "homepage": "https://github.com/itsflaid/devmap#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "dependencies": {
    "commander": "^12.0.0",
    "ignore": "^7.0.6",
    "p-limit": "^7.3.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
