{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.itsflaid/devmap",
  "description": "Query a codebase map (routes, features, flows, impact) built by static analysis.",
  "repository": {
    "url": "https://github.com/itsflaid/devmap",
    "source": "github",
    "subfolder": "packages/cli"
  },
  "version": "0.9.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@flaid/devmap",
      "version": "0.9.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
